# Client-visible configuration. VITE_* values are embedded in the build and MUST NOT contain secrets.
# Use only deliberately exposed read-only endpoints. Production deployments must use HTTPS.
# A trailing slash is accepted and normalized by the adapter.
VITE_POWV_GATEWAY_URL=http://127.0.0.1:5002
VITE_POWV_AUDIT_URL=http://127.0.0.1:5003
